+def _mark_superseded(directive_id: str, *, superseded_by: str, reason: str) -> dict:
+    """Reescribe UNA línea de DIRECTIVES_FILE con status=SUPERSEDED +
+    superseded_by/superseded_reason/superseded_at -- mismo patrón de
+    reescritura ya usado por `human_review_queue.supersede_finding()`
+    (leer todas las líneas, mutar una, reescribir el archivo completo).
+    La línea nunca se borra ni pierde ningún campo original -- append-only
+    a nivel de historia, aunque la implementación reescriba el archivo
+    físico. Función privada: el único llamador real es
+    `propose_remediation_directive()`, después de que la directiva
+    sustituta ya se validó y persistió con éxito, y SIEMPRE con el lock de
+    `_directives_lock_file()` ya tomado por ese llamador -- esta función no
+    adquiere el lock ella misma (evita el doble-lock/deadlock de pedirlo
+    dos veces en el mismo proceso vía fds distintos)."""
+    if not DIRECTIVES_FILE.exists():
+        raise RemediationDirectiveError(f"directive_id={directive_id!r}: no existe ({DIRECTIVES_FILE} no existe)")
+    lines = DIRECTIVES_FILE.read_text(encoding="utf-8").splitlines()
+    entries = [json.loads(line) for line in lines if line.strip()]
+    matched = None
+    for e in entries:
+        if e["directive_id"] == directive_id:
+            e["status"] = "SUPERSEDED"
+            e["superseded_by"] = superseded_by
+            e["superseded_reason"] = reason
+            e["superseded_at"] = datetime.now(timezone.utc).isoformat()
+            matched = e
+            break
+    if matched is None:
+        raise RemediationDirectiveError(f"directive_id={directive_id!r}: no encontrado en {DIRECTIVES_FILE}")
+
+    DIRECTIVES_FILE.write_text(
+        "\n".join(json.dumps(e, ensure_ascii=False) for e in entries) + "\n", encoding="utf-8")
+
+    write_event("remediation_directive_superseded", matched.get("document_id", "unknown"), {
+        "directive_id": directive_id, "superseded_by": superseded_by, "reason": reason,
+    })
+    return matched
+
+
