+def test_supersede_marks_old_directive_superseded_and_links_new_one(
+        isolated_review_queue, isolated_directives, fake_document):
+    finding_rc = _enqueue_confirmed(conclusion="PROVISIONAL_GAP")
+    old = rd.propose_remediation_directive(**_base_kwargs(finding_rc))
+    assert old["status"] == "SUBMITTED"
+
+    new = rd.propose_remediation_directive(**_base_kwargs(
+        finding_rc, target_location={"page_start": 5, "page_end": 5, "section": None},
+        supersedes_directive_id=old["directive_id"],
+    ))
+    assert new["status"] == "SUBMITTED"
+    assert new["supersedes_directive_id"] == old["directive_id"]
+
+    reloaded_old = rd.get_directive(old["directive_id"])
+    assert reloaded_old["status"] == "SUPERSEDED"
+    assert reloaded_old["superseded_by"] == new["directive_id"]
+    assert reloaded_old["superseded_reason"]
+    assert reloaded_old["superseded_at"]
+    # Append-only: la linea vieja sigue teniendo TODOS sus campos originales.
+    assert reloaded_old["proposed_text"] == old["proposed_text"]
+    assert reloaded_old["target_location"] == old["target_location"]
+
