+def test_supersede_already_superseded_directive_is_rejected(
+        isolated_review_queue, isolated_directives, fake_document):
+    finding_rc = _enqueue_confirmed(conclusion="PROVISIONAL_GAP")
+    original = rd.propose_remediation_directive(**_base_kwargs(finding_rc))
+    replacement = rd.propose_remediation_directive(
+        **_base_kwargs(finding_rc, supersedes_directive_id=original["directive_id"]))
+
+    with pytest.raises(rd.RemediationDirectiveError, match="SUBMITTED"):
+        rd.propose_remediation_directive(
+            **_base_kwargs(finding_rc, supersedes_directive_id=original["directive_id"]))
+    # La sustituta vigente (replacement) sí puede volver a superseder-se.
+    third = rd.propose_remediation_directive(
+        **_base_kwargs(finding_rc, supersedes_directive_id=replacement["directive_id"]))
+    assert third["supersedes_directive_id"] == replacement["directive_id"]
+
