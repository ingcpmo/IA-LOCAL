+def test_supersede_race_detected_under_lock_is_rejected(
+        isolated_review_queue, isolated_directives, fake_document, monkeypatch):
+    """El chequeo inicial (status SUBMITTED) corre SIN lock, antes de la
+    validacion lenta (PDF, anclaje, catalogo). Este test simula que, entre
+    ese chequeo y la escritura real, otra solicitud concurrente ya
+    superseded-eo la misma directiva -- el re-chequeo hecho DENTRO del lock
+    (justo antes de escribir) debe detectarlo y rechazar, en vez de pisar
+    el supersede ajeno."""
+    finding_rc = _enqueue_confirmed(conclusion="PROVISIONAL_GAP")
+    old = rd.propose_remediation_directive(**_base_kwargs(finding_rc))
+
+    real_get_directive = rd.get_directive
+    calls = []
+
+    def _flaky_get_directive(directive_id):
+        calls.append(directive_id)
+        result = real_get_directive(directive_id)
+        if len(calls) == 2 and result is not None:
+            # Segunda llamada = el re-chequeo bajo lock: simula que otra
+            # solicitud ya lo superseded-eo justo en ese instante.
+            result = dict(result)
+            result["status"] = "SUPERSEDED"
+        return result
+
+    monkeypatch.setattr(rd, "get_directive", _flaky_get_directive)
+
+    with pytest.raises(rd.RemediationDirectiveError, match="dejó de estar SUBMITTED"):
+        rd.propose_remediation_directive(**_base_kwargs(
+            finding_rc, supersedes_directive_id=old["directive_id"]))
+    assert len(calls) == 2
+
+    # La directiva original nunca se tocó -- el rechazo bajo lock no dejó
+    # ninguna escritura a medias.
+    reloaded_old = real_get_directive(old["directive_id"])
+    assert reloaded_old["status"] == "SUBMITTED"
+
