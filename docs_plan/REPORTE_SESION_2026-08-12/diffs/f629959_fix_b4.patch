+def _d_assessments_partial(met_indices: set[int]) -> list:
+    """Como _d_assessments_subset, pero los indices fuera de met_indices
+    quedan NOT_MET (desacuerdo genuino, no NOT_ASSESSABLE) -- reproduce el
