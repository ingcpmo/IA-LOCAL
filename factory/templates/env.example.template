# Variables de entorno para {{project_id}}
# Copiar a .env y completar los valores reales
# NUNCA commitear .env (está en .gitignore)

# Generar con: openssl rand -hex 16
GMP_API_KEY=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL={{ollama_model}}

DATABASE_URL=postgresql://{{project_id}}_user:CAMBIAR_PASSWORD@{{project_id}}_postgres:5432/{{project_id}}_db
REDIS_URL=redis://{{project_id}}_redis:6379/0

CHROMA_PERSIST_DIR=/app/data/chroma
AUDIT_LOG_DIR=/app/data/audit_logs

# Puertos asignados por factory/registry/ports.yaml
API_PORT={{api_port}}
POSTGRES_PORT={{postgres_port}}
REDIS_PORT={{redis_port}}
