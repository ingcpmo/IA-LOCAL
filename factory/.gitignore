workspaces/*
deployments/*/.env
logs/*
*.tar.gz
audit/factory_audit.jsonl
.env

# --- Artefactos de runtime (salida de corridas, no fuente) ---

# Locks de cualquier motor/paquete/cola (layer9, remediation_packages, audit, test_results)
*.lock

# Estado mutable del runtime (el .example sí se versiona)
runtime/claude_status.json

# Logs append-only de auditoría
audit/*.jsonl

# Resultados de corridas de tests de soluciones
test_results/

# Área de paso de la ingesta de fuentes: el fichero descargado antes de que
# human_source_registration lo copie al almacén inmutable. La copia gobernada
# (regulatory/sources/sha256/<hash>/) SÍ se versiona; ésta es byte a byte
# idéntica, así que versionarla sólo duplicaría el artefacto.
regulatory/sources/incoming/

# Estado de conectores y logs append-only del módulo regulatorio
regulatory/connector_state.json
regulatory/broken_link_report.jsonl
regulatory/source_currency_log.jsonl
regulatory/case_memory/*.jsonl

# Estado interno de paquetes de remediación (el contenido versionado v*/ sí se conserva)
remediation_packages/**/state.json

# Checkpoints de motores (p.ej. engines/gmpai_integrity/.checkpoints_autoclave_urs/)
**/.checkpoints_*/

# R2: índice BM25 por documento (regenerable desde el PDF real, sha256 en
# el nombre de archivo -- mismo criterio que los checkpoints de arriba)
regulatory/retrieval_index/

# R2.2 §4.3: índice de embeddings por documento (regenerable re-llamando a
# Ollama con el mismo modelo/digest declarado en EMBED_EXECUTION -- mismo
# criterio que retrieval_index/, nunca fuente de verdad)
regulatory/embedding_index/

# V2 B1: store del modelo canónico por documento (SQLite regenerable desde
# el PDF real con canonical/extract_document.py -- mismo criterio que
# retrieval_index/, nunca fuente de verdad)
regulatory/canonical_store/

# V2 B2: grafo de evidencia/conocimiento por proyecto (SQLite regenerable
# desde el canonical_store + el catálogo con graph/build.py -- mismo
# criterio que canonical_store/)
regulatory/graph_store/

# V2 B9: artefactos de shadow mode (salida de corrida, sin efectos,
# regenerable) y flag local de routing
regulatory/pilot_run/v2_shadow/
regulatory/validation_v2/routing.txt

# Config local de Claude Code dentro de deployments
deployments/*/.claude/

# Artefacto de un `pip install paquete >=1.1.0` mal citado
=1.1.0
