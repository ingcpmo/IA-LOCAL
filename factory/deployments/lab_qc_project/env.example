# Variables de entorno para lab_qc_project
# Copiar a .env y completar los valores reales
# NUNCA commitear .env (está en .gitignore)

# Generar con: openssl rand -hex 16
GMP_API_KEY=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M

DATABASE_URL=postgresql://lab_qc_project_user:CAMBIAR_PASSWORD@lab_qc_project_postgres:5432/lab_qc_project_db
REDIS_URL=redis://lab_qc_project_redis:6379/0

CHROMA_PERSIST_DIR=/app/data/chroma
AUDIT_LOG_DIR=/app/data/audit_logs

# Puertos asignados por factory/registry/ports.yaml
API_PORT=8101
POSTGRES_PORT=5433
REDIS_PORT=6380
